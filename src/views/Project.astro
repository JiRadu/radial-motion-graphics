---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Drawing from "../components/Drawing.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import SectionHead from "../components/SectionHead.astro";
import { PROJECTS, type Project } from "../data/projects";
import { serviceById } from "../data/services";
import { creativeWork } from "../lib/schema";
import { child, r, t, type Lang } from "../i18n/ui";

interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const ui = t(lang);
const ro = lang === "ro";
const svc = serviceById(p.service);
const href = child("projects", lang, p.slug[lang]);
const alternates = { ro: child("projects", "ro", p.slug.ro), en: child("projects", "en", p.slug.en) };
const crumbs = [
  { name: ui.home, href: r("home", lang) },
  { name: ui.nav.projects, href: r("projects", lang) },
  { name: p.title[lang], href },
];
const others = PROJECTS.filter((x) => x.id !== p.id).sort((a, b) => Number(b.service === p.service) - Number(a.service === p.service)).slice(0, 3);
---

<Base
  lang={lang}
  title={`${p.title[lang]} | Radial Cons`}
  description={`${p.summary[lang]} ${ui.material}: ${p.material[lang]}. ${ui.finish}: ${p.finish[lang]}.`}
  alternates={alternates}
  section="projects"
  jsonLd={[creativeWork({ name: p.title[lang], description: p.summary[lang], href, lang, material: p.material[lang] })]}
>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={svc.short[lang]} title={p.headline[lang]} lead={p.summary[lang]} />

  <section class="section">
    <div class="container">
      <dl class="specs">
        <div><dt>{ui.category}</dt><dd><a href={child("services", lang, svc.slug[lang])}>{svc.short[lang]}</a></dd></div>
        <div><dt>{ui.material}</dt><dd>{p.material[lang]}</dd></div>
        <div><dt>{ui.finish}</dt><dd>{p.finish[lang]}</dd></div>
        <div><dt>{ui.location}</dt><dd>{p.setting[lang]}</dd></div>
      </dl>
      <div class="split split--wide-left split--top">
        <div>
          <h2>{p.title[lang]}</h2>
          <div class="prose">{p.story[lang].map((s) => <p>{s}</p>)}</div>
          <h3 style="margin-top:32px">{ui.scope}</h3>
          <ol class="features features--plain" style="margin-top:12px">
            {p.scope[lang].map((s, i) => <li><span class="num">{String(i + 1).padStart(2, "0")}</span><div><p>{s}</p></div></li>)}
          </ol>
        </div>
        <div>
          {p.photos?.length
            ? <>
                <a class="photo-main" href={p.photos[0].src} target="_blank" rel="noopener">
                  <img class="photo" src={p.photos[0].src} srcset={`${p.photos[0].srcSm} 640w, ${p.photos[0].src} 1080w`} sizes="(min-width: 900px) 40vw, 100vw" alt={p.photos[0].alt[lang]} width="1080" height="1350" fetchpriority="high" decoding="async" />
                </a>
                <p class="figure-note">{p.photos[0].alt[lang]}</p>
              </>
            : <>
                <div class="media media--portrait"><Drawing name={p.drawing} label={`${ui.illustration}: ${p.title[lang]}`} /></div>
                <p class="figure-note">{ro ? "Desen tehnic ilustrativ. Fotografiile lucrării vor fi adăugate în curând." : "Illustrative technical drawing. Project photos coming soon."}</p>
              </>}
        </div>
      </div>
    </div>
  </section>

  {p.photos && p.photos.length > 1 && (
    <section class="section section--dark" aria-label={ro ? "Galerie foto" : "Photo gallery"}>
      <div class="container">
        <SectionHead eyebrow={ro ? "Galerie" : "Gallery"} title={ro ? "Fotografii de pe lucrare." : "Photos from the job."} />
        <ul class="gallery grid grid--3 grid--scroll">
          {p.photos.map((ph) => (
            <li>
              <a href={ph.src} target="_blank" rel="noopener">
                <img class="photo" src={ph.srcSm} srcset={`${ph.srcSm} 640w, ${ph.src} 1080w`} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 84vw" alt={ph.alt[lang]} width="640" height="800" loading="lazy" decoding="async" />
              </a>
              <p class="figure-note">{ph.alt[lang]}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--cream">
    <div class="container">
      <SectionHead eyebrow={ui.nav.projects} title={ui.otherProjects} link={{ href: r("projects", lang), label: ui.allProjects }} />
      <div class="grid grid--3 grid--scroll">{others.map((o) => <ProjectCard project={o} lang={lang} />)}</div>
    </div>
  </section>

  <CtaBand lang={lang} title={ro ? "Vrei ceva asemănător?" : "Want something similar?"} />
</Base>
