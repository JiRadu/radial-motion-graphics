---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Drawing from "../components/Drawing.astro";
import CtaBand from "../components/CtaBand.astro";
import { SERVICES } from "../data/services";
import { SITE } from "../data/site";
import { child, r, ROUTES, t, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const ro = lang === "ro";
const title = ro
  ? "Servicii — mobilier, structuri metalice, producție la comandă, debitare laser | Radial Cons"
  : "Services — furniture, steel structures, custom parts, laser cutting | Radial Cons";
const description = ro
  ? "Mobilier și vetre de foc, structuri metalice, producție la comandă din DXF/STEP, debitare și sudură laser, plasmă, îndoire CNC și fier forjat — în Târgoviște."
  : "Furniture and firepits, steel structures, custom parts from DXF/STEP, laser cutting and welding, plasma, CNC bending and wrought iron — made in Târgoviște, Romania.";
const crumbs = [
  { name: ui.home, href: r("home", lang) },
  { name: ui.nav.services, href: r("services", lang) },
];
---

<Base lang={lang} title={title} description={description} alternates={ROUTES.services} section="services">
  <PageHero
    lang={lang}
    crumbs={crumbs}
    eyebrow={ui.nav.services}
    title={ro ? "Piese metalice la comandă," : "Custom metal work,"}
    accent={ro ? "de la concept la montaj." : "from concept to installation."}
    lead={ro
      ? `Patru linii de lucru, în ordinea în care le prezentăm, plus porți, garduri și balustrade din fier forjat. Materiale: ${SITE.materials.ro.join(", ")}.`
      : `Four lines of work, in the order we present them, plus wrought iron gates, fences and railings. Materials: ${SITE.materials.en.join(", ")}.`}
  />

  {SERVICES.map((s, i) => (
    <section class:list={["section", { "section--cream": i % 2 === 1 }]} id={s.id}>
      <div class="container split">
        <div style={i % 2 === 1 ? "order:2" : undefined}>
          <p class="eyebrow">{s.secondary ? s.eyebrow[lang] : `${String(i + 1).padStart(2, "0")} · ${s.eyebrow[lang]}`}</p>
          <h2>{s.title[lang]}</h2>
          <span class="goldline" aria-hidden="true"></span>
          <p class="lead">{s.summary[lang]}</p>
          <ul class="checklist" style="margin:24px 0 0">
            {s.offer[lang].map((o) => <li>{o.title}</li>)}
          </ul>
          <div class="btn-row"><a class="btn btn--primary" href={child("services", lang, s.slug[lang])}>{ui.readMore}<span class="sr-only">: {s.short[lang]}</span></a></div>
        </div>
        <div style="aspect-ratio:1/1"><Drawing name={s.drawing} label={`${ui.illustration}: ${s.short[lang]}`} tone={i % 2 === 1 ? "dark" : "light"} /></div>
      </div>
    </section>
  ))}

  <CtaBand lang={lang} />
</Base>
