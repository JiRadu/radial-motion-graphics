---
import Drawing from "./Drawing.astro";
import type { Project } from "../data/projects";
import { serviceById } from "../data/services";
import { child, t, type Lang } from "../i18n/ui";

interface Props { project: Project; lang: Lang; headingLevel?: "h2" | "h3" }
const { project: p, lang, headingLevel = "h3" } = Astro.props;
const ui = t(lang);
const H = headingLevel;
const svc = serviceById(p.service);
---

<a class="card" href={child("projects", lang, p.slug[lang])} data-project={p.service}>
  <div class="card__media">
    {p.photos?.[0]
      ? <img class="photo" src={p.photos[0].srcSm} srcset={`${p.photos[0].srcSm} 640w, ${p.photos[0].src} 1080w`} sizes="(min-width: 1000px) 25vw, (min-width: 640px) 50vw, 84vw" alt={p.photos[0].alt[lang]} loading="lazy" decoding="async" width="640" height="800" />
      : <Drawing name={p.drawing} label={`${ui.illustration}: ${p.title[lang]}`} />}
  </div>
  <div class="card__body">
    <span class="card__meta">{svc.short[lang]} · {p.material[lang]}</span>
    <H>{p.title[lang]}</H>
    <p>{p.summary[lang]}</p>
    <span class="link-arrow">{ui.seeProject}</span>
  </div>
</a>
